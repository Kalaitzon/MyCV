# Copy this file to ".env" and fill in ONE of the two AI keys below.
# .env is git-ignored — it must never be committed or deployed.

# --- Option A: Google Gemini (has a free tier) -----------------------------
# Get a key at https://aistudio.google.com/apikey — no card required.
# Note: Google states that free-tier content may be used to improve its
# products. Use Option B, or Gemini's paid tier, if that matters to you.
GEMINI_API_KEY=

# --- Option B: Anthropic Claude (paid, ~$0.13 per import) ------------------
# Get a key at https://console.anthropic.com → Settings → API keys
ANTHROPIC_API_KEY=

# Optional. If both keys are set, Gemini wins because it is free.
# Force one with: gemini | anthropic
# CV_PROVIDER=gemini

# Optional: override the model. The Gemini default is gemini-flash-latest,
# an alias that always points at the current Flash model. Pinned versions
# (e.g. gemini-2.5-flash) stay visible in the models list after they stop
# being served, so they are a poor default.
#   Gemini models: https://ai.google.dev/gemini-api/docs/models
#   Claude models: https://docs.claude.com/en/docs/about-claude/models
# CV_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# The variables below are NOT used by the local script. They are only needed
# on Vercel, for the in-browser "Update CV" window (api/import-cv.js).
# Set them in Vercel -> Settings -> Environments -> Production.
#
#   ADMIN_PASSWORD   the password you type in the site to publish a new CV
#   GITHUB_TOKEN     fine-grained token, Contents: Read and write, this repo only
#   GITHUB_REPO      Kalaitzon/Digital-CV
#   GITHUB_BRANCH    optional, defaults to main
# ---------------------------------------------------------------------------
